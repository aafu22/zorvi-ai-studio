# Copy to .env (never commit .env)
APP_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where uploads, processed images and exports are stored (git-ignored)
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
# Hours before temporary files may be deleted
FILE_TTL_HOURS=24
# AI Marketing Brain uses the Google Gemini API. Leave the key empty and the rest of the app still works.
# Get a key at https://aistudio.google.com/apikey (never commit your real key).
# The free tier has low rate limits and Google may use free-tier content to improve its products,
# so do not enter confidential information. Paid usage is billed by Google.
GEMINI_API_KEY=
# Model name is configurable; check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
# Optional: folder containing sample-product.jpg for the demo (default: <repo>/sample_assets)
SAMPLE_ASSETS_DIR=

# ---- Limits on the AI features (Marketing Brain and Photo Assistant need sign-in) ----
# Per signed-in user, and one daily cap for the whole server. Counted in memory: reset on restart, per worker.
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_HOUR=30
AI_DAILY_LIMIT_TOTAL=500

# ---- Database
# Empty = SQLite file in the storage folder (fine on your own computer).
# For hosting (disk wiped on restart, e.g. Render free plan) use PostgreSQL, e.g. a free Neon database:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ---- Accounts: email verification and password reset ----
# The public address of the website. Links in emails point here.
# Local: http://localhost:3000 (or https://localhost:3000 with local HTTPS). Production: https://your-domain
FRONTEND_URL=http://localhost:3000
# true = new accounts must click the emailed link before they can sign in.
REQUIRE_EMAIL_VERIFICATION=true
VERIFICATION_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=60
# Outgoing email (SMTP). Leave SMTP_HOST empty while developing: emails are then PRINTED in the
# backend terminal (with the link) instead of being sent, so you can test without a mail account.
# Example for Gmail (needs 2-step verification + an "App password", not your normal password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Shown as the sender, e.g. Zorvi AI Studio <you@gmail.com>. Empty = SMTP_USERNAME.
SMTP_FROM=
# false = STARTTLS (port 587, most providers); true = implicit TLS (port 465)
SMTP_USE_SSL=false
# Alternative to SMTP: send through the Brevo web API (https://www.brevo.com). Use this on hosts that block
# SMTP ports. If BREVO_API_KEY is set it is used instead of SMTP. The sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Zorvi AI Studio

# ---- HTTPS ----
# true = redirect http:// requests to https://. Turn on only when the site is really served over HTTPS
# (behind Caddy/nginx or a hosting platform). Leave false for plain local development.
FORCE_HTTPS=false
