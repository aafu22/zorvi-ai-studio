# Copy to .env.local (never commit it). This is the ONLY place the backend URL is set.
# Do not put secrets here: NEXT_PUBLIC_* values are visible in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production: set to your https address (e.g. https://zorvi.example.com), then run `npm run build` again;
# NEXT_PUBLIC_* values are fixed into the build. Local HTTPS: https://localhost:8000
# Optional, production site only: send the HSTS header (see README, "Going live with HTTPS").
# ENABLE_HSTS=true
