index 0000000..8e0f98f
--- /dev/null
+++ b/backend/app/services/auth_service.py
@@ -0,0 +1,158 @@
+"""Accounts and login sessions (standard library only: no extra packages needed).
+
+- Passwords are hashed with scrypt and a random per-user salt. The plain password is never stored.
+- A successful sign-up / login returns a random session token. Only its SHA-256 hash is stored,
+  so a leaked database file does not reveal usable tokens.
+- Failed logins are throttled in memory per email address (resets when the server restarts).
+"""
+
+import base64
+import hashlib
+import hmac
+import re
+import secrets
+import time
+from datetime import datetime, timedelta, timezone
+
+from app.core.errors import AppError
+from app.database.db import connect
+from app.schemas.auth import AuthResponse, LoginRequest, SignupRequest, UserOut
+
+SESSION_DAYS = 30
+_SCRYPT_N, _SCRYPT_R, _SCRYPT_P = 2**14, 8, 1
+_EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
+
+# Brute-force protection: after MAX_FAILURES wrong passwords, wait out the lock window.
+MAX_FAILURES = 8
+LOCK_SECONDS = 15 * 60
+_failures: dict[str, list[float]] = {}
+
+
+def _now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _b64(data: bytes) -> str:
+    return base64.b64encode(data).decode("ascii")
+
+
+def hash_password(password: str) -> str:
+    salt = secrets.token_bytes(16)
+    digest = hashlib.scrypt(
+        password.encode("utf-8"), salt=salt, n=_SCRYPT_N, r=_SCRYPT_R, p=_SCRYPT_P, dklen=32
+    )
+    return f"scrypt${_SCRYPT_N}${_SCRYPT_R}${_SCRYPT_P}${_b64(salt)}${_b64(digest)}"
+
+
+def verify_password(password: str, stored: str) -> bool:
+    try:
+        scheme, n, r, p, salt_b64, hash_b64 = stored.split("$")
+        if scheme != "scrypt":
+            return False
+        expected = base64.b64decode(hash_b64)
+        digest = hashlib.scrypt(
+            password.encode("utf-8"),
+            salt=base64.b64decode(salt_b64),
+            n=int(n),
+            r=int(r),
+            p=int(p),
+            dklen=len(expected),
+        )
+    except (ValueError, TypeError):
+        return False
+    return hmac.compare_digest(digest, expected)
+
+
+# A real hash to compare against when the email is unknown, so "no such user" and
+# "wrong password" take about the same time and look the same to the caller.
+_DUMMY_HASH = hash_password("not-a-real-password")
+
+
+def _token_hash(token: str) -> str:
+    return hashlib.sha256(token.encode("utf-8")).hexdigest()
+
+
+def _normalise_email(email: str) -> str:
+    email = email.strip().lower()
+    if not _EMAIL_RE.match(email):
+        raise AppError(422, "Please enter a valid email address.")
+    return email
+
+
+def _issue_session(conn, user_id: int) -> str:
+    token = secrets.token_urlsafe(32)
+    now = _now()
+    conn.execute("DELETE FROM sessions WHERE expires_at < ?", (now.isoformat(),))
+    conn.execute(
+        "INSERT INTO sessions (token_hash, user_id, created_at, expires_at) VALUES (?, ?, ?, ?)",
+        (
+            _token_hash(token),
+            user_id,
+            now.isoformat(),
+            (now + timedelta(days=SESSION_DAYS)).isoformat(),
+        ),
+    )
+    return token
+
+
+def signup(req: SignupRequest) -> AuthResponse:
+    name = req.name.strip()
+    if not name:
+        raise AppError(422, "Please enter your name.")
+    email = _normalise_email(req.email)
+    with connect() as conn:
+        if conn.execute("SELECT 1 FROM users WHERE email = ?", (email,)).fetchone():
+            raise AppError(409, "An account with this email already exists. Try signing in.")
+        cur = conn.execute(
+            "INSERT INTO users (name, email, password_hash, created_at) VALUES (?, ?, ?, ?)",
+            (name, email, hash_password(req.password), _now().isoformat()),
+        )
+        user_id = cur.lastrowid
+        token = _issue_session(conn, user_id)
+    return AuthResponse(token=token, user=UserOut(id=user_id, name=name, email=email))
+
+
+def _check_not_locked(email: str) -> None:
+    cutoff = time.time() - LOCK_SECONDS
+    recent = [t for t in _failures.get(email, []) if t > cutoff]
+    _failures[email] = recent
+    if len(recent) >= MAX_FAILURES:
+        raise AppError(429, "Too many failed attempts. Please wait a few minutes and try again.")
+
+
+def login(req: LoginRequest) -> AuthResponse:
+    email = req.email.strip().lower()
+    _check_not_locked(email)
+    with connect() as conn:
+        row = conn.execute(
+            "SELECT id, name, email, password_hash FROM users WHERE email = ?", (email,)
+        ).fetchone()
+        ok = verify_password(req.password, row["password_hash"] if row else _DUMMY_HASH)
+        if not row or not ok:
+            _failures.setdefault(email, []).append(time.time())
+            raise AppError(401, "Incorrect email or password.")
+        _failures.pop(email, None)
+        token = _issue_session(conn, row["id"])
+    return AuthResponse(
+        token=token, user=UserOut(id=row["id"], name=row["name"], email=row["email"])
+    )
+
+
+def user_for_token(token: str) -> UserOut | None:
+    with connect() as conn:
+        row = conn.execute(
+            """
+            SELECT u.id, u.name, u.email, s.expires_at
+            FROM sessions s JOIN users u ON u.id = s.user_id
+            WHERE s.token_hash = ?
+            """,
+            (_token_hash(token),),
+        ).fetchone()
+    if not row or datetime.fromisoformat(row["expires_at"]) < _now():
+        return None
+    return UserOut(id=row["id"], name=row["name"], email=row["email"])
+
+
+def logout(token: str) -> None:
+    with connect() as conn:
+        conn.execute("DELETE FROM sessions WHERE token_hash = ?", (_token_hash(token),))
diff --git a/backend/tests/test_auth_api.py b/backend/tests/test_auth_api.py
